# Copie para .env e ajuste. Nunca commite o .env.
SECRET_KEY=
DATABASE_URI=sqlite:///tasks.db
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Notificações desligadas por default — a app nunca bloqueia em SMTP no dev.
EMAIL_ENABLED=0
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
