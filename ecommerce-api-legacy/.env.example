# Copie para .env e ajuste. Nunca commite o .env.
NODE_ENV=development
PORT=3000
DB_FILE=:memory:
SEED_ON_BOOT=1
LOG_LEVEL=info

# Habilita DELETE /api/users/:id. Sem este valor o endpoint responde 503 (finding F11).
ADMIN_API_TOKEN=

# 'simulated' não cobra nada e é o default fora de produção.
# Produção exige 'live' explicitamente, e 'live' exige integrar um provedor real (finding F05).
PAYMENT_MODE=simulated
APPROVED_CARD_PREFIX=4
# Obrigatória em produção. Rotacione a chave que estava hardcoded em src/utils.js.
PAYMENT_GATEWAY_KEY=
